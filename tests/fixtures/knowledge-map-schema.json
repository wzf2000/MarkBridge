{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "enum": ["knowledge-map/v1"]
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": ["id", "title"]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "group": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 96
          },
          "description": {
            "type": "string",
            "maxLength": 240
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["document", "local-document", "step", "activity"]
              },
              "namespace": {
                "type": "string",
                "maxLength": 34
              },
              "document": {
                "type": "string",
                "maxLength": 34
              },
              "site": {
                "type": "string",
                "maxLength": 34
              },
              "documentId": {
                "type": "string",
                "maxLength": 512
              },
              "target": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": ["kind"]
          },
          "role": {
            "type": "string",
            "enum": ["concept", "reading", "practice"]
          }
        },
        "required": ["id", "group", "title", "role", "target"]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 64
          },
          "to": {
            "type": "string",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["prerequisite", "explains", "practises"]
          },
          "why": {
            "type": "string",
            "maxLength": 240
          },
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["from", "to", "kind", "id"]
      }
    }
  },
  "required": ["format", "title", "groups", "nodes", "edges"]
}
