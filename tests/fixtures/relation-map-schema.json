{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "enum": ["relation-map/v1"]
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": ["id", "title"]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "group": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "maxLength": 1024
          },
          "description": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": ["id", "group", "title", "url"]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 64
          },
          "to": {
            "type": "string",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["recommended", "compare", "optimization"]
          },
          "why": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": ["from", "to", "kind"]
      }
    }
  },
  "required": ["format", "title", "groups", "nodes", "edges"]
}
