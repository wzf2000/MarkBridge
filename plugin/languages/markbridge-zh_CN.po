#, php-format
#: plugin/editor-ui.js
msgid "%1$s difference: green additions, red deletions, and gray unchanged context."
msgid_plural "%1$s differences: green additions, red deletions, and gray unchanged context."
msgstr[0] "共 %1$s 处差异；绿色为新增，红色为删除，灰色为未变上下文。"

#: plugin/i18n.js
msgid " (older baseline; compare conflicts)"
msgstr "（旧版本基线，须比较冲突）"

#: plugin/i18n.js
msgid " (permissions changed; candidate preserved)"
msgstr "（权限已变，候选保留）"

#: plugin/i18n.js
msgid " (source binding changed)"
msgstr "（来源绑定已变）"

#: plugin/i18n.js
msgid " Apply "
msgstr " 应用 "

#: plugin/i18n.js
msgid " I understand that original static media URLs may become public after upload, even when the article is a private draft."
msgstr " 我了解：上传后原始媒体静态 URL 可能公开，即使文章是私密草稿。"

#: plugin/i18n.js
msgid " Input has not been applied. Article saving is paused."
msgstr " 输入尚未应用，文章保存已暂停。"

#: plugin/i18n.js
msgid " Prepare the export again."
msgstr " 请重新准备导出。"

#: plugin/i18n.js
msgid " Static fallback content remains readable. You can start again."
msgstr " 静态替代内容仍可阅读；可重新启动。"

#: plugin/i18n.js
msgid " and others"
msgstr "等"

#: plugin/i18n.js
msgid " block"
msgstr "所在区块"

#: plugin/i18n.js
msgid " is executable."
msgstr " 可执行。"

#: plugin/i18n.js
msgid " is missing or not executable."
msgstr " 缺失或不可执行。"

#: plugin/i18n.js
msgid " isolated interactive preview"
msgstr " 隔离交互预览"

#: plugin/i18n.js
msgid " source"
msgstr "侧源码补末尾换行"

#: plugin/i18n.js
msgid " · Another tab"
msgstr " · 另一标签页"

#: plugin/i18n.js
msgid " · Conversion backend: "
msgstr " · 转换后端："

#: plugin/i18n.js
msgid " · Older record awaiting verification"
msgstr " · 旧记录待校验"

#: plugin/i18n.js
msgid " · Restored from #"
msgstr " · 恢复自 #"

#: plugin/i18n.js
msgid " · This tab"
msgstr " · 本标签页"

#: plugin/i18n.js
msgid "\">Edit Markdown</button> <button class=\"button mbb-history\" data-post=\""
msgstr "\">Markdown 编辑</button> <button class=\"button mbb-history\" data-post=\""

#: plugin/i18n.js
msgid "\">Export saved article</button></li>"
msgstr "\">导出已保存文章</button></li>"

#: plugin/i18n.js
msgid "\">Manage image emoji packs</a> "
msgstr "\">管理图片表情包</a> "

#: plugin/i18n.js
msgid "\">New article</a> "
msgstr "\">新建文章</a> "

#: plugin/i18n.js
msgid "\">Next page</a>"
msgstr "\">下一页</a>"

#: plugin/i18n.js
msgid "\">Previous page</a> "
msgstr "\">上一页</a> "

#: plugin/i18n.js
msgid "\">Revisions / restore</button> <button class=\"button mbb-export\" data-post=\""
msgstr "\">历史版本 / 恢复</button> <button class=\"button mbb-export\" data-post=\""

#: plugin/i18n.js
msgid "\">Settings</a>"
msgstr "\">设置</a>"

#: plugin/i18n.js
msgid "\">Upload Markdown</a> "
msgstr "\">上传 Markdown</a> "

#: plugin/i18n.js
msgid "\">View settings and diagnostics</a>."
msgstr "\">查看设置与诊断</a>。"

#: plugin/i18n.js
msgid "$$ must occupy a complete line"
msgstr "$$ 必须独占一行"

#, php-format
#: plugin/i18n.js
msgid "%1$s (block %2$s)"
msgstr "%1$s（第 %2$s 个区块）"

#, php-format
#: plugin/i18n.js
msgid "%1$s / 8 versions; %2$s / 131072 bytes"
msgstr "%1$s / 8 个版本；%2$s / 131072 字节"

#, php-format
#: plugin/i18n.js
msgid "%1$s reference markers will be updated. No change has been applied."
msgstr "将更新 %1$s 处引用标记，尚未应用修改。"

#, php-format
#: plugin/i18n.js
msgid "%1$s · %2$s · %3$s×%4$s · %5$s bytes"
msgstr "%1$s · %2$s · %3$s×%4$s · %5$s 字节"

#, php-format
#: plugin/i18n.js
msgid "%1$s. Reading the latest version for comparison."
msgstr "%1$s。正在读取最新版以供比较。"

#: plugin/i18n.js
msgid ", "
msgstr "、"

#: plugin/i18n.js
msgid ", attribute"
msgstr "，属性"

#: plugin/i18n.js
msgid ", column "
msgstr "，第 "

#: plugin/i18n.js
msgid ", reference "
msgstr " 的第 "

#: plugin/i18n.js
msgid ". Check the differences and preview before confirming."
msgstr "。请检查差异和预览后确认。"

#: plugin/i18n.js
msgid ". Check this block's formatting, or download Markdown for safekeeping before correcting and previewing it again."
msgstr "。请检查该区块的格式，或先下载 Markdown 保留候选，再修正并重新预览。"

#: plugin/i18n.js
msgid ". The current candidate is preserved. Download it or compare manually."
msgstr "。当前候选未丢弃，请下载或手动比较。"

#: plugin/i18n.js
msgid ". The source is preserved. You can retry."
msgstr "。已保留源码，可重试。"

#: plugin/i18n.js
msgid "1. Select and order articles"
msgstr "1. 选择文章并排序"

#: plugin/i18n.js
msgid "2. Metadata and scope"
msgstr "2. 元数据与范围"

#: plugin/i18n.js
msgid "3. Prepare, confirm, download"
msgstr "3. 准备、确认、下载"

#: plugin/i18n.js
msgid "; automatic three-way merge is unavailable. Download the candidate and compare manually."
msgstr "；自动三方合并不可用，原候选可下载并手动比较。"

#: plugin/i18n.js
msgid "; click or press Enter to view the formula and TeX"
msgstr "；点击或按 Enter 查看公式与 TeX"

#: plugin/i18n.js
msgid "; repeated structure cannot be located reliably"
msgstr "；重复结构无法可靠定位"

#: plugin/i18n.js
msgid "; the original candidate remains downloadable. Verify the latest version again."
msgstr "；原候选仍可下载，请重新核对最新版。"

#: plugin/i18n.js
msgid "</form><h2>Optional image resources</h2><p>Unicode emoji are used by default. Administrators may import image packs; basic installation requires no resource downloads.</p>"
msgstr "</form><h2>可选图片资源</h2><p>默认使用 Unicode 表情。图片包由管理员导入，基础安装不需要下载资源。</p>"

#: plugin/i18n.js
msgid "</select> <button class=\"button\" name=\"operation\" value=\"select\">Enable selected pack</button> <button class=\"button\" name=\"operation\" value=\"delete\">Delete inactive pack</button></p></form>"
msgstr "</select> <button class=\"button\" name=\"operation\" value=\"select\">启用所选</button> <button class=\"button\" name=\"operation\" value=\"delete\">删除未启用包</button></p></form>"

#: plugin/i18n.js
msgid "</select> <button class=\"button\" name=\"operation\" value=\"select\">Enable selected pack</button> <button class=\"button\" name=\"operation\" value=\"delete\">Delete inactive pack</button></p></form></div>"
msgstr "</select> <button class=\"button\" name=\"operation\" value=\"select\">启用所选</button> <button class=\"button\" name=\"operation\" value=\"delete\">删除未启用包</button></p></form></div>"

#: plugin/i18n.js
msgid "</select></p><p class=\"description\">Only adjusts the Markdown editing window, not body or frontend fonts. Refresh an already open editing window.</p>"
msgstr "</select></p><p class=\"description\">仅调整 Markdown 编辑窗口，不改变正文或前台字体。已打开的编辑窗口需刷新。</p>"

#: plugin/i18n.js
msgid "</tbody></table><h2>Rejected registrations</h2><ul>"
msgstr "</tbody></table><h2>登记拒绝</h2><ul>"

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/issues\">Report an issue</a>"
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/issues\">反馈问题</a>"

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/issues\">Report an issue</a></p>"
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/issues\">反馈问题</a></p>"

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/wiki\">Documentation</a>"
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/wiki\">使用文档</a>"

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/wiki\">Documentation</a> · "
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/wiki\">使用文档</a> · "

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/wiki/Emoji-Packs\">Image pack guide</a></p>"
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/wiki/Emoji-Packs\">图片包说明</a></p>"

#: plugin/i18n.js
msgid "<a href=\"https://github.com/wzf2000/MarkBridge/wiki/Getting-Started\">Quick start</a> · "
msgstr "<a href=\"https://github.com/wzf2000/MarkBridge/wiki/Getting-Started\">快速开始</a> · "

#: plugin/i18n.js
msgid "<details><summary>Compatibility and advanced runtime settings</summary><p>Current backend: "
msgstr "<details><summary>兼容与高级：转换运行环境</summary><p>当前后端："

#: plugin/i18n.js
msgid "<div class=\"notice notice-error\"><p>Display settings contain invalid values. Original settings are unchanged.</p></div>"
msgstr "<div class=\"notice notice-error\"><p>显示设置含无效值，原设置保持不变。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-error\"><p>Display settings could not be saved. Check the database state.</p></div>"
msgstr "<div class=\"notice notice-error\"><p>显示设置未能保存，请检查数据库状态。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-error\"><p>The database configuration could not be saved. Check the database state. No successful switch was reported.</p></div>"
msgstr "<div class=\"notice notice-error\"><p>无法保存数据库配置，请检查数据库状态；未报告切换成功。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-error\"><p>The proposed runtime failed verification. Original settings are unchanged.</p></div>"
msgstr "<div class=\"notice notice-error\"><p>候选运行环境未通过验证，原设置保持不变。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-info\"><p>This runtime directory endpoint cannot currently change configuration. Refresh the page and use the conversion backend settings. Server-managed directories cannot be overridden.</p></div>"
msgstr "<div class=\"notice notice-info\"><p>此运行目录接口当前不可修改配置，请刷新页面并使用转换方案；服务器常量管理的目录不能覆盖。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-success\"><p>Display settings saved.</p></div>"
msgstr "<div class=\"notice notice-success\"><p>显示设置已保存。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"notice notice-success\"><p>The runtime was verified and enabled.</p></div>"
msgstr "<div class=\"notice notice-success\"><p>运行环境已经验证并启用。</p></div>"

#: plugin/i18n.js
msgid "<div class=\"wrap\"><h1>MarkBridge image emoji</h1><p>Unicode is used by default; external resources are not automatically downloaded. No download source is bundled. Import only image packs with known provenance and licensing. Importing does not grant a license to use the resources.</p>"
msgstr "<div class=\"wrap\"><h1>MarkBridge 图片表情</h1><p>默认使用 Unicode，不自动下载外部资源。当前没有预置下载源；可导入具有明确来源与许可的图片数据包。导入不授予资源使用许可。</p>"

#: plugin/i18n.js
msgid "<div class=\"wrap\"><h1>MarkBridge teaching extensions</h1><p>Read-only diagnostics: fixed local resources and public data-only parameters. At most 2 active executions and 4 previews; parameters are limited to 16 KiB. Static content and configuration are preserved when an extension is disabled.</p><table class=\"widefat striped\"><thead><tr><th>Component</th><th>Version / protocol / minimum MarkBridge</th><th>Status</th><th>Budgets</th></tr></thead><tbody>"
msgstr "<div class=\"wrap\"><h1>MarkBridge 教学扩展</h1><p>只读诊断：固定本地资源与公开纯数据参数。执行并发上限 2，预览上限 4；参数上限 16 KiB。停用扩展后静态正文与原配置仍保留。</p><table class=\"widefat striped\"><thead><tr><th>组件</th><th>版本 / 协议 / 最低 MarkBridge</th><th>状态</th><th>预算</th></tr></thead><tbody>"

#: plugin/i18n.js
msgid "<div class=\"wrap\"><h1>Markdown editing bridge</h1><p>Upload Markdown for editing in both representations. Preview differences before saving, publishing, or submitting for review. Set a featured image before publishing.</p><p><button class=\"button button-primary\" id=\"mbb-new\">Upload a new document</button></p><ul>"
msgstr "<div class=\"wrap\"><h1>Markdown 编辑桥</h1><p>上传Markdown后可双向编辑；通过差异预览保存、发布或提交审核。发布前请设置特色图片。</p><p><button class=\"button button-primary\" id=\"mbb-new\">上传新文档</button></p><ul>"

#: plugin/i18n.js
msgid "<h2>Conversion backend</h2>"
msgstr "<h2>转换方案</h2>"

#: plugin/i18n.js
msgid "<h2>Diagnostics</h2><table class=\"widefat striped\"><tbody>"
msgstr "<h2>诊断</h2><table class=\"widefat striped\"><tbody>"

#: plugin/i18n.js
msgid "<h2>Editing experience</h2><p><label for=\"mbb-source-font-size\">Markdown source font size</label> "
msgstr "<h2>编辑体验</h2><p><label for=\"mbb-source-font-size\">Markdown 源码字号</label> "

#: plugin/i18n.js
msgid "<h2>Formula and code display</h2><table class=\"form-table\"><tbody>"
msgstr "<h2>公式与代码显示</h2><table class=\"form-table\"><tbody>"

#: plugin/i18n.js
msgid "<h2>Overview and getting started</h2><p>Version: "
msgstr "<h2>概览与开始使用</h2><p>版本："

#: plugin/i18n.js
msgid "<h2>Unapplied candidate diagnostics: "
msgstr "<h2>未应用的候选方案诊断："

#: plugin/i18n.js
msgid "<input type=\"hidden\" name=\"operation\" value=\"import\"><input type=\"file\" name=\"pack_zip\" accept=\".zip\" required><button class=\"button\">Import pack</button></form><form method=\"post\">"
msgstr "<input type=\"hidden\" name=\"operation\" value=\"import\"><input type=\"file\" name=\"pack_zip\" accept=\".zip\" required><button class=\"button\">导入数据包</button></form><form method=\"post\">"

#: plugin/i18n.js
msgid "<label for=\"mbb-runtime-path\">Private server directory</label> "
msgstr "<label for=\"mbb-runtime-path\">服务器私有目录</label> "

#: plugin/i18n.js
msgid "<p class=\"description\">MARKBRIDGE_RUNTIME is defined. An invalid constant does not fall back to database settings.</p>"
msgstr "<p class=\"description\">MARKBRIDGE_RUNTIME 已定义；常量无效时不会回退数据库设置。</p>"

#: plugin/i18n.js
msgid "<p class=\"description\">MARKBRIDGE_RUNTIME is server-managed and overrides only the Node directory. An invalid constant does not fall back to the database directory.</p>"
msgstr "<p class=\"description\">MARKBRIDGE_RUNTIME 由服务器管理，只覆盖 Node 目录；无效常量不会回退数据库目录。</p>"

#: plugin/i18n.js
msgid "<p class=\"description\">Selecting PHP preserves the existing valid Node directory for later switching and does not use the directory entered here.</p>"
msgstr "<p class=\"description\">选择 PHP 会保留当前有效 Node 目录，便于之后切回；不使用本次输入的目录。</p>"

#: plugin/i18n.js
msgid "<p class=\"mbb-adapter-unavailable\" data-mbb-generated=\"\" role=\"status\">The static block adapter package or version is unavailable. Saved content and configuration are preserved; conversion and paired restoration are unavailable.</p>"
msgstr "<p class=\"mbb-adapter-unavailable\" data-mbb-generated=\"\" role=\"status\">静态区块适配包或版本不可用；已保存内容与配置保留，转换和配对恢复暂不可用。</p>"

#: plugin/i18n.js
msgid "<p><a href=\"https://github.com/wzf2000/MarkBridge/wiki/Runtime\">Node runtime preparation and configuration</a></p>"
msgstr "<p><a href=\"https://github.com/wzf2000/MarkBridge/wiki/Runtime\">Node 环境准备与配置说明</a></p>"

#: plugin/i18n.js
msgid "<p><label for=\"mbb-converter-path\">Private Node directory</label> "
msgstr "<p><label for=\"mbb-converter-path\">Node 私有目录</label> "

#: plugin/i18n.js
msgid "<p>A basic installation uses bundled PHP and needs no server directory configuration. Existing Node configuration is preserved during upgrades. Administrators can verify and select a backend below.</p>"
msgstr "<p>基础安装使用内置 PHP，无需填写服务器路径。已有 Node 配置升级后继续沿用；管理员可在下方验证并选择转换方案。</p>"

#: plugin/i18n.js
msgid "<p>Active configuration source: "
msgstr "<p>有效配置来源："

#: plugin/i18n.js
msgid "<p>Current backend: "
msgstr "<p>当前后端："

#: plugin/i18n.js
msgid "<p>MARKBRIDGE_CONVERTER_BACKEND is defined. The backend is server-managed and cannot be overridden here.</p>"
msgstr "<p>MARKBRIDGE_CONVERTER_BACKEND 已定义，转换方案由服务器管理；后台不能覆盖。</p>"

#: plugin/i18n.js
msgid "<p>New installations default to PHP. Node requires a matching private server runtime prepared beforehand. Changes apply only after verification, never rewrite content, and do not automatically fall back on failure.</p>"
msgstr "<p>新安装默认 PHP。Node 需先在服务器准备匹配的私有运行环境；验证通过才应用。切换不改写正文，失败不会自动回退。</p>"

#: plugin/i18n.js
msgid "<p>Select the engine in the conversion backend settings above. PHP requires no private Node directory, and failures do not fall back to another backend.</p>"
msgstr "<p>请在上方转换方案选择引擎。PHP 不需要 Node 私有目录，失败不会回退其他后端。</p>"

#: plugin/i18n.js
msgid "<p>The current conversion configuration is invalid and will be rejected explicitly. No other backend is selected automatically.</p>"
msgstr "<p>当前转换配置无效，转换将明确拒绝；不会自动选择其他引擎。</p>"

#: plugin/i18n.js
msgid "<p>These results describe the failed candidate, not the currently active backend.</p><table class=\"widefat striped\"><tbody>"
msgstr "<p>以下结果来自失败候选，不代表当前生效方案。</p><table class=\"widefat striped\"><tbody>"

#: plugin/i18n.js
msgid "<p>Unicode is used by default; external resources are not automatically downloaded. No download source is bundled. Import only image packs with known provenance and licensing. Importing does not grant a license to use the resources.</p>"
msgstr "<p>默认使用 Unicode，不自动下载外部资源。当前没有预置下载源；可导入具有明确来源与许可的图片数据包。导入不授予资源使用许可。</p>"

#: plugin/i18n.js
msgid "A CSL-JSON author is invalid"
msgstr "CSL-JSON 作者数据无效"

#: plugin/i18n.js
msgid "A CSL-JSON issue date is invalid"
msgstr "CSL-JSON 出版日期无效"

#: plugin/i18n.js
msgid "A CSL-JSON record has an unsupported or missing type"
msgstr "CSL-JSON 记录的类型缺失或不受支持"

#: plugin/i18n.js
msgid "A CSL-JSON record requires a bounded string or safe integer id"
msgstr "CSL-JSON 记录需有界字符串或安全整数 ID"

#: plugin/i18n.js
msgid "A DOI must be a bounded supported DOI identifier, without a URL prefix"
msgstr "DOI 必须是有界且受支持的标识符，不含网址前缀"

#: plugin/i18n.js
msgid "A FrontMatter header is limited to 16 KiB"
msgstr "FrontMatter 头最多 16 KiB"

#: plugin/i18n.js
msgid "A JSON export request is required"
msgstr "需要 JSON 导出请求"

#: plugin/i18n.js
msgid "A ZIP may contain only one Markdown document and PNG/JPEG/GIF/WebP images"
msgstr "ZIP 只接受一个 Markdown 文稿及 PNG/JPEG/GIF/WebP"

#: plugin/i18n.js
msgid "A ZIP may contain only one document and at most 32 images"
msgstr "ZIP 只能有一个文稿和最多 32 张图片"

#: plugin/i18n.js
msgid "A batch operation is in progress. Refresh its status after it completes."
msgstr "批次操作正在进行，请在完成后刷新状态。"

#: plugin/i18n.js
msgid "A batch requires at most five items"
msgstr "一次批处理最多五项"

#: plugin/i18n.js
msgid "A bibliography requires 1–64 entries within 64 KiB"
msgstr "参考文献需要 1–64 个条目，合计不超过 64 KiB"

#: plugin/i18n.js
msgid "A button group requires 1–32 direct link buttons"
msgstr "按钮组需要 1–32 个直接链接按钮"

#: plugin/i18n.js
msgid "A button may contain only a link"
msgstr "按钮只能包含链接"

#: plugin/i18n.js
msgid "A code comparison must begin with two fenced code blocks"
msgstr "代码比较必须以两份围栏代码开始"

#: plugin/i18n.js
msgid "A code group may contain only the corresponding number of fences"
msgstr "代码组只能包含对应版本数量的围栏"

#: plugin/i18n.js
msgid "A code group requires 1–8 versions"
msgstr "代码组需有 1–8 个版本"

#: plugin/i18n.js
msgid "A code version ID duplicates a document anchor"
msgstr "代码版本 ID 与文档锚点重复"

#: plugin/i18n.js
msgid "A code version title must be empty or single-line text of at most 200 characters"
msgstr "代码版本标题需为空或不超过 200 字符的单行文字"

#: plugin/i18n.js
msgid "A column must be a direct child of columns"
msgstr "列区块必须直接位于分栏中。"

#: plugin/i18n.js
msgid "A complex list contains a non-list item"
msgstr "复杂列表包含非列表项"

#: plugin/i18n.js
msgid "A document may contain only one footnote definition section"
msgstr "一篇文档只能有一个脚注定义区"

#: plugin/i18n.js
msgid "A document permits one empty top-level logical identity"
msgstr "文档只允许一个位于顶层且无内容的逻辑身份"

#: plugin/i18n.js
msgid "A file did not finish uploading. No drafts were created."
msgstr "有文件尚未上传完成，未创建任何草稿。"

#: plugin/i18n.js
msgid "A footnote definition is not referenced"
msgstr "脚注定义未被引用"

